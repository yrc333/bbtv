<?xml version="1.0" encoding="utf-8"?>
<!-- 手机竖屏搜索页：输入框置顶，键盘与历史/热搜列表纵向堆叠 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/base_container"
    android:clipChildren="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layout_search_input"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:addStatesFromChildren="true"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">
            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/image_search_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_marginEnd="10dp"
                android:contentDescription="@string/search"
                app:srcCompat="@drawable/ic_search"
                app:tint="?android:attr/textColorPrimary"/>
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:focusable="true"
                android:hint="@string/search"
                android:imeOptions="actionSearch"
                android:maxLines="1"
                android:padding="0dp"
                android:singleLine="true"
                android:textColor="?android:attr/textColorPrimary"
                android:textColorHint="?android:attr/textColorSecondary"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </androidx.appcompat.widget.LinearLayoutCompat>

        <com.mytvb.feature.search.view.KeyboardView
            android:id="@+id/view_keyboard"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="45"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_center"
            android:visibility="gone"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="20"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_view_end"
            android:clipChildren="false"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="35"/>
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/view_search_result"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?attr/backgroundColor">
        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/button_result_back"
            android:background="@drawable/cell_background"
            android:padding="10dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/back"
            app:layout_constraintBottom_toBottomOf="@+id/layout_result_search_box"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layout_result_search_box"
            app:srcCompat="@drawable/ic_back"
            app:tint="?android:attr/textColorPrimary"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/layout_result_search_box"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_search_input"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            app:layout_constraintEnd_toStartOf="@+id/button_order"
            app:layout_constraintStart_toEndOf="@+id/button_result_back"
            app:layout_constraintTop_toTopOf="parent">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="@string/search"
                app:srcCompat="@drawable/ic_search"
                app:tint="?android:attr/textColorPrimary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/text_result_keyword"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tab_search_result"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/layout_result_search_box"
            app:tabBackground="@android:color/transparent"
            app:tabIndicator="@drawable/underline"
            app:tabIndicatorColor="?attr/colorAccent"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="2dp"
            app:tabMode="scrollable"
            app:tabRippleColor="@android:color/transparent"
            app:tabSelectedTextColor="?android:attr/textColorPrimary"
            app:tabTextAppearance="@style/SearchPageTabText"/>
        <androidx.appcompat.widget.LinearLayoutCompat
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/button_order"
            android:background="@drawable/cell_background"
            android:padding="6dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            app:layout_constraintBottom_toBottomOf="@+id/layout_result_search_box"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/layout_result_search_box">
            <androidx.appcompat.widget.AppCompatImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                app:srcCompat="@drawable/ic_order"
                app:tint="?android:attr/textColorPrimary"/>
            <androidx.appcompat.widget.AppCompatTextView
                android:textSize="12sp"
                android:textColor="?android:attr/textColorPrimary"
                android:id="@+id/text_order"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/total_rank"/>
        </androidx.appcompat.widget.LinearLayoutCompat>
        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/view_pager_result"
            android:descendantFocusability="afterDescendants"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tab_search_result"/>
        <TextView
            android:id="@+id/text_search_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/transparent_black_bg"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="10dp"
            android:text="@string/search_empty"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/view_pager_result"
            app:layout_constraintEnd_toEndOf="@+id/view_pager_result"
            app:layout_constraintStart_toStartOf="@+id/view_pager_result"
            app:layout_constraintTop_toTopOf="@+id/view_pager_result"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
