<?xml version="1.0" encoding="utf-8"?>
<!-- 手机竖屏导航栏：横向排布在屏幕底部 -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/transparent"
    android:paddingLeft="6dp"
    android:paddingRight="6dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_search"
        android:background="@drawable/tab_round_background"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusRight="@+id/button_home"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/search"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_home"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/ic_search"
        app:tint="?attr/tabBarNormal"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_home"
        android:background="@drawable/tab_round_background"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/button_search"
        android:nextFocusRight="@+id/button_category"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/home"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_category"
        app:layout_constraintStart_toEndOf="@+id/button_search"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/ic_home"
        app:tint="?attr/tabBarNormal"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_category"
        android:background="@drawable/tab_round_background"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/button_home"
        android:nextFocusRight="@+id/button_dynamic"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/zone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_dynamic"
        app:layout_constraintStart_toEndOf="@+id/button_home"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/tab_recommend"
        app:tint="?attr/tabBarNormal"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_dynamic"
        android:background="@drawable/tab_round_background"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/button_category"
        android:nextFocusRight="@+id/button_live"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/dynamic"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_live"
        app:layout_constraintStart_toEndOf="@+id/button_category"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/tab_dynamic"
        app:tint="?attr/tabBarNormal"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_live"
        android:background="@drawable/tab_round_background"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/button_dynamic"
        android:nextFocusRight="@+id/button_cctv_live"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/live"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_cctv_live"
        app:layout_constraintStart_toEndOf="@+id/button_dynamic"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/tab_live"
        app:tint="?attr/tabBarNormal"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_cctv_live"
        android:background="@drawable/tab_round_background"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:visibility="gone"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/button_live"
        android:nextFocusRight="@+id/button_me"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/cctv_live"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_me"
        app:layout_constraintStart_toEndOf="@+id/button_live"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/ic_tv"
        app:tint="?attr/tabBarNormal"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_me"
        android:background="@drawable/tab_round_background"
        android:padding="12dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/button_cctv_live"
        android:nextFocusRight="@+id/image_avatar"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:contentDescription="@string/me"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/image_avatar"
        app:layout_constraintStart_toEndOf="@+id/button_cctv_live"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHorizontal_weight="1"
        app:srcCompat="@drawable/tab_me"
        app:tint="?attr/tabBarNormal"/>

    <com.mytvb.core.ui.image.AvatarBadgeView
        android:id="@+id/image_avatar"
        android:background="@drawable/tab_round_background"
        android:padding="8dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerCrop"
        android:nextFocusLeft="@+id/button_me"
        android:nextFocusRight="@+id/button_setting"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/user"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_setting"
        app:layout_constraintStart_toEndOf="@+id/button_me"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/default_avatar"/>

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/button_setting"
        android:background="@drawable/tab_round_background"
        android:padding="10dp"
        android:focusable="true"
        android:clickable="true"
        android:scaleType="centerInside"
        android:nextFocusLeft="@+id/image_avatar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="4dp"
        android:contentDescription="@string/setting"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/image_avatar"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_setting"
        app:tint="?android:attr/textColorPrimary"/>
</androidx.constraintlayout.widget.ConstraintLayout>
